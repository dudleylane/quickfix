#ifndef FIX_QUICKFIX_VERSION_H
#define FIX_QUICKFIX_VERSION_H

// Generated by CMake from src/C++/QuickFIXVersion.h.in into include/quickfix/. The version is the
// one project() declares in the top-level CMakeLists.txt, which also sets the library's soname:
// change it there, not here.
#define QUICKFIX_VERSION "@PROJECT_VERSION@"
#define QUICKFIX_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define QUICKFIX_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define QUICKFIX_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define QUICKFIX_FORK "hardened"
#define QUICKFIX_FORK_URL "https://github.com/dudleylane/quickfix"

#endif
