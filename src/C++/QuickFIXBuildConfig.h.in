#ifndef FIX_QUICKFIX_BUILD_CONFIG_H
#define FIX_QUICKFIX_BUILD_CONFIG_H

// Generated by CMake from src/C++/QuickFIXBuildConfig.h.in into each build tree, and installed beside
// the other headers. It records the build options that change code a consumer compiles inline, so a
// program built against these headers makes the same choice as the library it links. Today that is
// the TBB allocator: ALLOCATOR in Utility.h backs FieldMap::Fields and the socket send queues, and
// inline code that frees with one allocator what the library allocated with the other corrupts the
// heap.
#cmakedefine01 QUICKFIX_TBB_ALLOCATOR

#if QUICKFIX_TBB_ALLOCATOR
#ifndef ENABLE_TBB_ALLOCATOR
#define ENABLE_TBB_ALLOCATOR 1
#endif
#elif defined(ENABLE_TBB_ALLOCATOR) && ENABLE_TBB_ALLOCATOR
#error "ENABLE_TBB_ALLOCATOR is defined, but this quickfix was built without the TBB allocator"
#endif

// Whether the library was built with SSL. The SSL headers include this file before they test
// HAVE_SSL, so a program built against an SSL-enabled install can use them without defining
// HAVE_SSL itself (#63); nothing else the package provides defines it.
#cmakedefine01 QUICKFIX_HAVE_SSL

#if QUICKFIX_HAVE_SSL
#ifndef HAVE_SSL
#define HAVE_SSL 1
#endif
#elif defined(HAVE_SSL) && HAVE_SSL
#error "HAVE_SSL is defined, but this quickfix was built without SSL"
#endif

// The database backends the library was built with, recorded as SSL is: their headers include this
// file before they test HAVE_MYSQL, HAVE_POSTGRESQL or HAVE_ODBC, so a program built against a
// database-enabled install can use them without defining those itself (#137).
#cmakedefine01 QUICKFIX_HAVE_MYSQL
#cmakedefine01 QUICKFIX_HAVE_POSTGRESQL
#cmakedefine01 QUICKFIX_HAVE_ODBC

#if QUICKFIX_HAVE_MYSQL
#ifndef HAVE_MYSQL
#define HAVE_MYSQL 1
#endif
#elif defined(HAVE_MYSQL) // config.h defines it with no value
#error "HAVE_MYSQL is defined, but this quickfix was built without MySQL"
#endif

#if QUICKFIX_HAVE_POSTGRESQL
#ifndef HAVE_POSTGRESQL
#define HAVE_POSTGRESQL 1
#endif
#elif defined(HAVE_POSTGRESQL) // config.h defines it with no value
#error "HAVE_POSTGRESQL is defined, but this quickfix was built without PostgreSQL"
#endif

#if QUICKFIX_HAVE_ODBC
#ifndef HAVE_ODBC
#define HAVE_ODBC 1
#endif
#elif defined(HAVE_ODBC) // config.h defines it with no value
#error "HAVE_ODBC is defined, but this quickfix was built without ODBC"
#endif

#endif
