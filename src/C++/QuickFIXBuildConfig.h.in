#ifndef FIX_QUICKFIX_BUILD_CONFIG_H
#define FIX_QUICKFIX_BUILD_CONFIG_H

// Generated by CMake from src/C++/QuickFIXBuildConfig.h.in into each build tree, and installed beside
// the other headers. It records the build options that change code a consumer compiles inline, so a
// program built against these headers makes the same choice as the library it links. Today that is
// the TBB allocator: ALLOCATOR in Utility.h backs FieldMap::Fields and the socket send queues, and
// inline code that frees with one allocator what the library allocated with the other corrupts the
// heap.
#cmakedefine01 QUICKFIX_TBB_ALLOCATOR

#if QUICKFIX_TBB_ALLOCATOR
#ifndef ENABLE_TBB_ALLOCATOR
#define ENABLE_TBB_ALLOCATOR 1
#endif
#elif defined(ENABLE_TBB_ALLOCATOR) && ENABLE_TBB_ALLOCATOR
#error "ENABLE_TBB_ALLOCATOR is defined, but this quickfix was built without the TBB allocator"
#endif

#endif
