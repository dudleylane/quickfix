# Generated by CMake from quickfix.pc.in. The prefix comes from this file's own location, so it stays
# right when cmake --install --prefix puts the install somewhere else.
prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: quickfix
Description: FIX protocol engine, a correctness-hardened fork of QuickFIX
URL: https://github.com/dudleylane/quickfix
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lquickfix@QUICKFIX_PC_LIBS@
Libs.private:@QUICKFIX_PC_LIBS_PRIVATE@
Cflags: -I${includedir}
